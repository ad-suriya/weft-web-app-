# ===========================================================================
# Vibe2Ship backend configuration.
#
# Copy this file to `.env` in THIS folder:
#     cp Dashboard/backend/.env.example Dashboard/backend/.env
#
# Then you only need to fill in the 2 lines marked  >>> FILL IN <<< .
# Every other value below is the shared team value — leave it as-is.
# Loaded by engine.py / db.py / auth.py. Never commit the real `.env`.
# ===========================================================================


# --- AI (Gemini) ---------------------------------------------------------
# Shared key — ask a teammate for it. Looks like:  AQ.Ab8RN6KUyEg...
# >>> FILL IN <<<
GEMINI_API_KEY=

GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash


# ======================================================================
# RUN MODE — CHOOSE ONE. This one choice covers BOTH the AI backend and
# the database, because they share the same Google login.
# ======================================================================
#
#  ---- Mode 1: full cloud (recommended) --------------------------------
#  Real Firestore + Vertex AI. Keep BOTH lines below as-is, and run once
#  in your shell:
#      gcloud auth application-default login
#  (a teammate must first grant your Google account access to the
#  project). Then leave FIREBASE_CREDENTIALS commented out.
#
GOOGLE_CLOUD_PROJECT=project-0ac2b94d-3be6-4ad1-b18
USE_FIRESTORE=1
#
#  ---- Mode 2: no cloud, no gcloud -----------------------------------
#  AI runs off GEMINI_API_KEY, database is an in-memory mock (data is
#  lost on restart). To use this mode, comment out BOTH lines above and
#  uncomment BOTH lines below:
# GOOGLE_CLOUD_PROJECT=
# USE_FIRESTORE=
#
#  ---- Mode 3: cloud database via a key file --------------------------
#  Like Mode 1 but instead of `gcloud auth ...`, put the service-account
#  JSON at  Dashboard/backend/firebase-service-account.json  and
#  uncomment this line (path is relative to Dashboard/):
# FIREBASE_CREDENTIALS=backend/firebase-service-account.json

# Shared, safe to keep as-is (used by Modes 1 and 3).
FIREBASE_PROJECT_ID=task-weave-93efd


# --- Google sign-in / Calendar OAuth ----------------------------------
# Shared client id, safe to keep as-is (client ids are public by design).
GOOGLE_OAUTH_CLIENT_ID=611514829994-jeeb1eg42ghcrmicruek2nbhmmf9fgo5.apps.googleusercontent.com

# Shared secret — ask a teammate for it. Looks like:  GOCSPX-8R1GCsx...
# >>> FILL IN <<<
GOOGLE_OAUTH_CLIENT_SECRET=

# Browser origin of the Vite dev server. The default matches `npm run dev`
# (port 5173) and is a registered OAuth redirect URI — only change this if
# Vite starts on a different port, and register that port's callback too.
# FRONTEND_ORIGIN=http://localhost:5173
