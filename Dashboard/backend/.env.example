# ===========================================================================
# Vibe2Ship backend configuration.
#
# Copy this file to `.env` in THIS folder:
#     cp Dashboard/backend/.env.example Dashboard/backend/.env
#
# Then you only need to fill in the 2 lines marked  >>> FILL IN <<< .
# Every other value below is the shared team value — leave it as-is.
# Loaded by engine.py / db.py / auth.py. Never commit the real `.env`.
# ===========================================================================


# --- AI (Gemini) ---------------------------------------------------------
# Shared key — ask a teammate for it. Looks like:  AQ.Ab8RN6KUyEg...
# >>> FILL IN <<<
GEMINI_API_KEY=

GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash


# ======================================================================
# RUN MODE — CHOOSE ONE. One choice covers BOTH the AI backend and the
# database, because they share the same Google credentials.
# ======================================================================

# These two are shared team values — keep them as-is for Mode 1 or Mode 3.
GOOGLE_CLOUD_PROJECT=project-0ac2b94d-3be6-4ad1-b18
USE_FIRESTORE=1

#  ---- Mode 1: gcloud login (no file) --------------------------------
#  Run once in your shell (a teammate must first grant your Google
#  account access to both projects):
#      gcloud auth application-default login
#      gcloud auth application-default set-quota-project project-0ac2b94d-3be6-4ad1-b18
#  Then leave the KEY FILE line below commented out. Nothing else to do.
#
#  ---- Mode 3: shared key file (what to use if a teammate sent you a
#       sa.json) ------------------------------------------------------
#  Put the JSON a teammate gave you at   Dashboard/backend/sa.json
#  and uncomment the ONE line below. This single var is read by both the
#  Firestore client and the Vertex AI client, so it covers everything.
#  The path is resolved from Dashboard/backend/ (where you start uvicorn).
# GOOGLE_APPLICATION_CREDENTIALS=sa.json
#
#  ---- Mode 2: no cloud at all --------------------------------------
#  AI runs off GEMINI_API_KEY above, DB is an in-memory mock (data lost
#  on restart). No gcloud, no key file. To use it, comment out BOTH
#  GOOGLE_CLOUD_PROJECT and USE_FIRESTORE above and uncomment these:
# GOOGLE_CLOUD_PROJECT=
# USE_FIRESTORE=

# Shared, safe to keep as-is (used by Mode 1 and Mode 3).
FIREBASE_PROJECT_ID=task-weave-93efd


# --- Google sign-in / Calendar OAuth ----------------------------------
# Shared client id, safe to keep as-is (client ids are public by design).
GOOGLE_OAUTH_CLIENT_ID=611514829994-jeeb1eg42ghcrmicruek2nbhmmf9fgo5.apps.googleusercontent.com

# Shared secret — ask a teammate for it. Looks like:  GOCSPX-8R1GCsx...
# >>> FILL IN <<<
GOOGLE_OAUTH_CLIENT_SECRET=

# Browser origin of the Vite dev server. The default matches `npm run dev`
# (port 5173) and is a registered OAuth redirect URI — only change this if
# Vite starts on a different port, and register that port's callback too.
# FRONTEND_ORIGIN=http://localhost:5173
