# Dashboard backend environment — copy to `.env` in this same folder and fill in.
#   cp Dashboard/backend/.env.example Dashboard/backend/.env
# Loaded by engine.py / db.py / auth.py via python-dotenv. Never commit the real `.env`.

# --- AI (Gemini) ---------------------------------------------------------------
# With GOOGLE_CLOUD_PROJECT set, the engine uses Vertex AI via Application
# Default Credentials (`gcloud auth application-default login`) and this key is
# only a fallback. Leave GOOGLE_CLOUD_PROJECT blank to force the Gemini
# Developer API and use the key directly.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# --- Persistence -------------------------------------------------------------
# USE_FIRESTORE=1 -> real Firestore (needs ADC or FIREBASE_CREDENTIALS below).
# Unset/blank      -> in-memory db_mock, no Google project needed (nothing persists).
USE_FIRESTORE=
FIREBASE_PROJECT_ID=
# Path to a Firebase service-account JSON (relative paths resolve against Dashboard/).
# Omit to fall back to Application Default Credentials.
# FIREBASE_CREDENTIALS=backend/firebase-service-account.json

# --- Google sign-in / Calendar OAuth ----------------------------------------
# Web application OAuth client (Google Cloud Console). The client id is safe to
# expose; the secret is not. Enable the
# https://www.googleapis.com/auth/calendar.events scope for Calendar sync.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Origin the browser talks to (Vite dev server). The OAuth redirect URI is
# `${FRONTEND_ORIGIN}/api/auth/google/callback` and must be registered on the
# OAuth client. Defaults to http://localhost:5173 — change only if you run the
# frontend on a different port.
# FRONTEND_ORIGIN=http://localhost:5173
