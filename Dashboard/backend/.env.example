# ===========================================================================
# Vibe2Ship — backend configuration
#
#   cp Dashboard/backend/.env.example Dashboard/backend/.env
#
# To get running:
#   1. Fill in the 2 lines marked  >>> FILL IN <<<  (ask a teammate).
#   2. Set up credentials — see the CREDENTIALS section below.
# Every other value is a shared team value; leave it as-is.
#
# Loaded by engine.py / db.py / auth.py. Never commit the real .env.
# ===========================================================================


# --- AI (Gemini on Vertex AI) --------------------------------------------
# >>> FILL IN <<<   shared key, looks like  AQ.Ab8RN6KUyEg...
GEMINI_API_KEY=

GOOGLE_CLOUD_PROJECT=project-0ac2b94d-3be6-4ad1-b18
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash


# --- Database (Firestore) ----------------------------------------------
FIREBASE_PROJECT_ID=task-weave-93efd
USE_FIRESTORE=1


# --- Credentials — CHOOSE ONE ----------------------------------------
# Firestore and the Vertex AI engine authenticate the same way, so one
# choice covers both.
#
#   Option A — gcloud login, no file:
#       gcloud auth application-default login
#       gcloud auth application-default set-quota-project project-0ac2b94d-3be6-4ad1-b18
#     Leave the line below commented out.
#
#   Option B — service-account key file:
#     Save the JSON a teammate sent you as
#         Dashboard/backend/firebase-service-account.json   (name is gitignored)
#     and uncomment this line. Path resolves from Dashboard/backend/.
# GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json


# --- Google sign-in / Calendar OAuth --------------------------------
GOOGLE_OAUTH_CLIENT_ID=611514829994-jeeb1eg42ghcrmicruek2nbhmmf9fgo5.apps.googleusercontent.com

# >>> FILL IN <<<   shared secret, looks like  GOCSPX-8R1GCsx...
GOOGLE_OAUTH_CLIENT_SECRET=

# Vite dev-server origin. Default matches `npm run dev` (port 5173) and is a
# registered OAuth redirect URI. Change only if Vite starts on another port
# (then register that port's callback too).
# FRONTEND_ORIGIN=http://localhost:5173
