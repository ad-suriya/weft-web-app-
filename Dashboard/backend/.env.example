# ===========================================================================
# Vibe2Ship backend configuration.
#
# Copy this file to `.env` in THIS folder:
#     cp Dashboard/backend/.env.example Dashboard/backend/.env
#
# Then you only need to fill in the 2 lines marked  >>> FILL IN <<< .
# Every other value below is the shared team value — leave it as-is.
# Loaded by engine.py / db.py / auth.py. Never commit the real `.env`.
# ===========================================================================


# --- AI (Gemini) -----------------------------------------------------------
# Shared key — ask a teammate for it. Looks like:  AQ.Ab8RN6KUyEg...
# >>> FILL IN <<<
GEMINI_API_KEY=

# Shared, safe to keep as-is. With GOOGLE_CLOUD_PROJECT set the engine uses
# Vertex AI (needs credentials, see "Firestore credentials" below — same
# login covers both). Blank it to use GEMINI_API_KEY directly instead.
GOOGLE_CLOUD_PROJECT=project-0ac2b94d-3be6-4ad1-b18
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash


# --- Persistence — CHOOSE ONE -------------------------------------------
# Option 1 (default): real Firestore. Keep the line below AND set up
#                     credentials (see next block).
USE_FIRESTORE=1
#
# Option 2: no database, in-memory mock. Data is lost on every restart, but
#           nothing Google is needed. To use it, comment the line above and
#           uncomment this one:
# USE_FIRESTORE=

# Shared, safe to keep as-is.
FIREBASE_PROJECT_ID=task-weave-93efd


# --- Firestore credentials — CHOOSE ONE (only if USE_FIRESTORE=1) -------
#
#   A) Application Default Credentials — recommended, no file to manage.
#      Run once in your shell:
#          gcloud auth application-default login
#      ...and leave FIREBASE_CREDENTIALS commented out below.
#
#   B) Service-account key file.
#      Put the JSON at:  Dashboard/backend/firebase-service-account.json
#      then uncomment exactly this line (path is relative to Dashboard/):
# FIREBASE_CREDENTIALS=backend/firebase-service-account.json


# --- Google sign-in / Calendar OAuth ----------------------------------
# Shared client id, safe to keep as-is (client ids are public by design).
GOOGLE_OAUTH_CLIENT_ID=611514829994-jeeb1eg42ghcrmicruek2nbhmmf9fgo5.apps.googleusercontent.com

# Shared secret — ask a teammate for it. Looks like:  GOCSPX-8R1GCsx...
# >>> FILL IN <<<
GOOGLE_OAUTH_CLIENT_SECRET=

# Browser origin of the Vite dev server. The default matches `npm run dev`
# (port 5173) and is a registered OAuth redirect URI — only change this if
# Vite starts on a different port, and register that port's callback too.
# FRONTEND_ORIGIN=http://localhost:5173
